{
  "name": "slackcn",
  "version": "0.1.0",
  "private": true,
  "description": "Block Kit components and TypeScript helpers, distributed through a shadcn registry.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "pnpm registry:build && next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "registry:build": "shadcn build registry.json --output public/r",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm format"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@slack/types": "^3.2.0",
    "@slack/web-api": "^8.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.9.1"
}
